SECRET_KEY=ganti-dengan-kunci-rahasia-yang-panjang-dan-acak
# development (lokal) atau production (Toolforge)
FLASK_ENV=development

# Daftarkan OAuth 2.0 consumer di: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
# Callback: https://<nama-tool>.toolforge.org/oauth/callback
WIKIMEDIA_CLIENT_ID=isi-client-id-di-sini
WIKIMEDIA_CLIENT_SECRET=isi-client-secret-di-sini

# Opsional, khusus lokal: token akses statis (owner-only consumer) agar login tanpa alur OAuth.
# Kosongkan di Toolforge supaya setiap pengguna login dengan akunnya sendiri.
# WIKIMEDIA_ACCESS_TOKEN=

# Opsional: folder database Perkaya. Di Toolforge otomatis memakai $TOOL_DATA_DIR.
# DATA_DIR=
